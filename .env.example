# Copy values you want to override into the appropriate file:
#   - Backend vars: export in your shell, or use a process manager / Node --env-file
#   - Frontend vars (NEXT_PUBLIC_*): place in frontend/.env.local (auto-loaded by Next.js)

# --- backend ---
# Port the Socket.IO / Express server listens on.
PORT=3002
# Allowed CORS origin (the frontend dev URL).
CORS_ORIGIN=http://localhost:3000

# --- frontend ---
# URL the browser uses to reach the backend Socket.IO server.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
